  <!--
    mdmerge receives RelativeDir metadata from the SDK reference items. On
    machines where the Windows SDK is installed under "Program Files (x86)",
    MSBuild escapes the parentheses in that metadata as %28/%29. mdmerge does
    not decode those path segments, so stage only the metadata roots required by
    the generated XAML provider under the project intermediate directory.
  -->
  <Target Name="CampusNetFixMdMergeMetadataDirectories"
          AfterTargets="GetCppWinRTMdMergeInputs"
          BeforeTargets="CppWinRTMergeProjectWinMDInputs">
    <RemoveDir Directories="$(IntDir)MdMergeMetadata" />
    <MakeDir Directories="$(IntDir)MdMergeMetadata" />
    <ItemGroup>
      <CampusNetMdMergeWinMD Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3719.77\lib\Microsoft.Web.WebView2.Core.winmd" />
      <CampusNetMdMergeWinMD Include="$(NuGetPackageRoot)microsoft.windowsappsdk.winui\$(WindowsAppSDKWinUIVersion)\metadata\Microsoft.UI.Text.winmd" />
      <CampusNetMdMergeWinMD Include="$(NuGetPackageRoot)microsoft.windowsappsdk.winui\$(WindowsAppSDKWinUIVersion)\metadata\Microsoft.UI.Xaml.winmd" />
      <CampusNetMdMergeWinMD Include="$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\$(WindowsAppSDKInteractiveExperiencesVersion)\metadata\10.0.18362.0\Microsoft.Foundation.winmd" />
      <CampusNetMdMergeWinMD Include="$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\$(WindowsAppSDKInteractiveExperiencesVersion)\metadata\10.0.18362.0\Microsoft.Graphics.winmd" />
      <CampusNetMdMergeWinMD Include="$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\$(WindowsAppSDKInteractiveExperiencesVersion)\metadata\10.0.18362.0\Microsoft.UI.winmd" />
      <CampusNetMdMergeWinMD Include="$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\$(WindowsAppSDKFoundationVersion)\metadata\Microsoft.Windows.ApplicationModel.Resources.winmd" />
      <CampusNetMdMergeWinMD Include="$(WindowsSDK_MetadataFoundationPath)\Windows.Foundation.FoundationContract.winmd" />
      <CampusNetMdMergeWinMD Include="$(WindowsSDK_MetadataPathVersioned)\Windows.Foundation.UniversalApiContract\19.0.0.0\Windows.Foundation.UniversalApiContract.winmd" />
    </ItemGroup>
    <Copy SourceFiles="@(CampusNetMdMergeWinMD)"
          DestinationFolder="$(IntDir)MdMergeMetadata"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <CppWinRTMdMergeMetadataDirectories Remove="@(CppWinRTMdMergeMetadataDirectories)" />
      <CppWinRTMdMergeMetadataDirectories Include="$(IntDir)MdMergeMetadata\*.winmd" />
    </ItemGroup>
  </Target>

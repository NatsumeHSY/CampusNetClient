    <CampusNetWindowsAppSdkRuntime Include="$(ProjectDir)..\runtime\win-x64\Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
    <CampusNetWindowsAppSdkRuntime Include="$(ProjectDir)..\runtime\win-x64\resources.pri" />
  </ItemGroup>
  <Target Name="CampusNetCopyWindowsAppSdkRuntime" AfterTargets="Build">

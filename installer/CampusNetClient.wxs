<?xml version="1.0" encoding="UTF-8"?>
<!-- Main WiX v4 source. build-msi.ps1 supplies the generated file inventory. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CampusNetClient"
           Manufacturer="Aetheria"
           Version="$(var.ProductVersion)"
           ProductCode="$(var.ProductCode)"
           UpgradeCode="{9B7E1B47-0F50-4F63-A1FC-6A3B8E2D5A17}"
           Scope="perMachine">
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="CampusNetClient" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ClientPayload" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CampusNetClient">
        <Directory Id="LOGSFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AETHERIA_DATA" Name="Aetheria">
        <Directory Id="CAMPUSNET_DATA" Name="CampusNetClient" />
      </Directory>
    </StandardDirectory>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ClientExecutableComponent" Guid="{3E4B1B61-0A4D-4B01-9A93-BA9FC72CC801}">
        <File Source="$(var.PackageBinDir)\CampusNetClient.exe" KeyPath="yes" />
      </Component>
      <Component Id="UpdaterExecutableComponent" Guid="{C8BF41F3-0C7C-41AB-91D4-63DFF2B1A0AC}">
        <File Source="$(var.PackageBinDir)\CampusNetUpdater.exe" KeyPath="yes" />
      </Component>
      <Component Id="ServiceExecutableComponent" Guid="{B61E1D2C-4E8C-4DB8-9C83-DC80C6F2B1F0}">
        <File Source="$(var.PackageBinDir)\CampusNetService.exe" KeyPath="yes" />
        <ServiceInstall Id="CampusNetServiceInstall"
                        Name="CampusNetService"
                        DisplayName="CampusNetService"
                        Description="CampusNetClient HTTP login service"
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal" />
        <ServiceControl Id="CampusNetServiceControl"
                        Name="CampusNetService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
      <Component Id="VersionRecordComponent" Guid="{0EBA4A98-A79B-4BA8-A8BB-0BBF54AF9014}">
        <File Source="$(var.VersionFile)" KeyPath="yes" />
      </Component>
      <Component Id="DataDirectoryComponent" Directory="CAMPUSNET_DATA" Guid="{F7B8E67A-8AF6-4F54-9EB3-6DD6B8D9E2EE}">
        <CreateFolder />
      </Component>
      <Component Id="LogDirectoryComponent" Directory="LOGSFOLDER" Guid="{2BA6F9CC-9AE0-4876-8B1E-7F0DC67CE4D6}">
        <CreateFolder />
        <RemoveFolder Id="RemoveLogsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

  <!--
    Windows App SDK self-contained payload items can be emitted beside the
    launcher by solution builds. The portable layout keeps every runtime file
    under bin, so fold any sibling payload back into bin after client and
    service outputs are present, then remove the duplicate top-level entries.
  -->
  <UsingTask TaskName="CampusNetNormalizePackageLayoutTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PackageRoot ParameterType="System.String" Required="true" />
      <BuildRoot ParameterType="System.String" Required="true" />
      <ConfigurationName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var packageRoot = Path.GetFullPath(PackageRoot)
            .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var buildRoot = Path.GetFullPath(BuildRoot)
            .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var expectedRoot = Path.GetFullPath(
            Path.Combine(buildRoot, "package", ConfigurationName))
            .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        if (!String.Equals(packageRoot, expectedRoot, StringComparison.OrdinalIgnoreCase) ||
            String.Equals(packageRoot, Path.GetPathRoot(packageRoot), StringComparison.OrdinalIgnoreCase))
        {
            Log.LogError("Refusing to normalize unexpected package directory: {0}", packageRoot);
            return false;
        }

        var bin = Path.Combine(packageRoot, "bin");
        var launcher = Path.Combine(packageRoot, "CampusNetLauncher.exe");
        if (!File.Exists(launcher) ||
            !File.Exists(Path.Combine(bin, "CampusNetClient.exe")) ||
            !File.Exists(Path.Combine(bin, "CampusNetService.exe")))
        {
            Log.LogError("Package normalization requires the launcher, client, and service outputs to exist.");
            return false;
        }

        var binPrefix = Path.GetFullPath(bin)
            .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) +
            Path.DirectorySeparatorChar;
        var payloadFiles = Directory.GetFiles(packageRoot, "*", SearchOption.AllDirectories)
            .Where(path =>
            {
                var fullPath = Path.GetFullPath(path);
                return !fullPath.StartsWith(binPrefix, StringComparison.OrdinalIgnoreCase) &&
                       !String.Equals(fullPath, launcher, StringComparison.OrdinalIgnoreCase);
            })
            .ToArray();

        foreach (var source in payloadFiles)
        {
            var relativePath = source.Substring(packageRoot.Length)
                .TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            var destination = Path.Combine(bin, relativePath);
            Directory.CreateDirectory(Path.GetDirectoryName(destination));
            File.Copy(source, destination, true);
        }

        foreach (var source in payloadFiles)
        {
            File.Delete(source);
        }

        var removedDirectories = 0;
        foreach (var directory in Directory.GetDirectories(packageRoot))
        {
            if (String.Equals(Path.GetFileName(directory), "bin", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }
            if ((File.GetAttributes(directory) & FileAttributes.ReparsePoint) != 0)
            {
                Log.LogError("Refusing to remove a reparse-point directory from the package root: {0}", directory);
                return false;
            }
            if (Directory.GetFiles(directory, "*", SearchOption.AllDirectories).Length != 0)
            {
                Log.LogError("Package-root directory still contains files after consolidation: {0}", directory);
                return false;
            }
            Directory.Delete(directory, true);
            removedDirectories++;
        }

        Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
            "CampusNet package layout normalized: moved {0} runtime files and removed {1} stray directories.",
            payloadFiles.Length, removedDirectories);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CampusNetNormalizePackageLayout"
          AfterTargets="Build"
          Condition="Exists('$(CampusNetPackageRoot)\bin\CampusNetClient.exe') and Exists('$(CampusNetPackageRoot)\bin\CampusNetService.exe')">
    <CampusNetNormalizePackageLayoutTask PackageRoot="$(CampusNetPackageRoot)"
                                         BuildRoot="$(CampusNetBuildRoot)"
                                         ConfigurationName="$(Configuration)" />
  </Target>
